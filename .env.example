# Demo listings are enabled by default so the UI works before live adapters are added.
# Set to false once at least one live source adapter is enabled.
RENTALS_DEMO_MODE=true

# Temporary in-process RAM cache. Defaults: 3 minutes / 30 second force-refresh guard.
CACHE_TTL_MS=180000
MIN_FORCE_REFRESH_AGE_MS=30000
