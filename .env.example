# Live phone-friendly HTTP sources.
ONEROOF_ENABLED=true
RAYWHITE_ENABLED=true
RAYWHITE_COMPLETE_ENABLED=true
BNPROPERTIES_ENABLED=true
QUINOVIC_ENABLED=true

# Summit's HTTP adapter is implemented but remains opt-in pending provider approval.
SUMMIT_ENABLED=false

# Demo listings are opt-in only.
RENTALS_DEMO_MODE=false

# Temporary in-process RAM cache. Defaults: 3 minutes / 30 second force-refresh guard.
CACHE_TTL_MS=180000
MIN_FORCE_REFRESH_AGE_MS=30000
